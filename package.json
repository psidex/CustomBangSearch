{
	"name": "customquicksearch",
	"version": "0.12.0",
	"description": "Use custom DuckDuckGo-style quick searches directly from the address bar",
	"main": "",
	"scripts": {
		"test": "esbuild \"src/**/*.test.ts\" --bundle --platform=node --outdir=.test-build --log-level=warning && node --test \".test-build/**/*.test.js\"",
		"lint": "biome lint ./src",
		"tsc-noemit": "tsc -noEmit",
		"build-firefox": "node ./bob.mjs -d -b firefox",
		"build-firefox-release": "node ./bob.mjs -z -s -b firefox",
		"build-chrome": "node ./bob.mjs -d -b chrome",
		"build-chrome-release": "node ./bob.mjs -z -s -b chrome"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/psidex/CustomQuickSearch.git"
	},
	"keywords": [
		"chrome",
		"firefox",
		"extension",
		"addon",
		"browser-extension",
		"web-extension",
		"chrome-extension",
		"firefox-extension",
		"firefox-addon",
		"search",
		"custom-search",
		"duckduckgo",
		"bang",
		"bangs",
		"quick",
		"quicksearch"
	],
	"author": "psidex",
	"license": "GPL-3.0",
	"bugs": {
		"url": "https://github.com/psidex/CustomQuickSearch/issues"
	},
	"homepage": "https://github.com/psidex/CustomQuickSearch#readme",
	"dependencies": {
		"@mantine/core": "9.6.3",
		"@mantine/hooks": "9.6.3",
		"@mantine/notifications": "9.6.3",
		"@uidotdev/usehooks": "2.4.1",
		"lucide-react": "1.48.0",
		"lz-string": "1.5.0",
		"react": "19.3.0",
		"react-dom": "19.3.0",
		"react-virtuoso": "4.18.15",
		"webextension-polyfill": "0.12.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.14",
		"@types/node": "26.6.3",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@types/webextension-polyfill": "0.12.6",
		"esbuild": "0.28.2",
		"execa": "10.0.1",
		"fs-extra": "11.4.1",
		"listr2": "11.1.0",
		"postcss": "8.5.28",
		"postcss-cli": "12.0.0",
		"postcss-preset-mantine": "1.18.0",
		"postcss-simple-vars": "7.0.1",
		"typescript": "7.0.2"
	},
	"allowScripts": {
		"esbuild@0.28.2": true
	}
}
